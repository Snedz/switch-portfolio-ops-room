[Unit]
Description=Portfolio Ops Room — Ops Agent (Switch-native)
After=network.target network-online.target docker.service
Wants=network-online.target

[Service]
WorkingDirectory=/root/portfolio-ops
ExecStart=/usr/bin/python3 /root/portfolio-ops/switch_agent.py
Restart=always
RestartSec=3

[Install]
WantedBy=multi-user.target
